# Copy to .env for local development. Never commit the real .env.
# In production these are set as environment variables (Render dashboard).

# --- required --------------------------------------------------------------
OPENAI_API_KEY=sk-...
# The app refuses to start if AUTH_PASSWORD is empty.
AUTH_USERNAME=admin
AUTH_PASSWORD=choose-a-strong-password

# --- optional --------------------------------------------------------------
OPENAI_VISION_MODEL=gpt-4o
RENDER_DPI=150
MAX_PAGES_PER_DOC=6

# Where the SQLite db and uploaded documents live.
# Unset -> ./data. Set to a mounted disk path to survive redeploys.
# DATA_DIR=/var/data

# Session cookie requires HTTPS. Set false for local http:// development.
COOKIE_SECURE=false
